DATABASE_URL=postgresql+asyncpg://leadforge:leadforge_pass@localhost:5432/leadforge
SECRET_KEY=your-secret-key-change-in-production-minimum-32-bytes

# ----------------------------------------------------------------------
# AI provider — see services/claude_service.py for the dispatch.
# AI_PROVIDER=openrouter (default) routes every AI call through
# OpenRouter. Set to AI_PROVIDER=anthropic to fall back to a direct
# Anthropic key (legacy path).
# ----------------------------------------------------------------------
AI_PROVIDER=openrouter

# OpenRouter — get your key at https://openrouter.ai/keys
# Pick a model from https://openrouter.ai/models
OPENROUTER_API_KEY=sk-or-your-key-here
OPENROUTER_MODEL=anthropic/claude-sonnet-4
# OPENROUTER_MODEL=openai/gpt-4o-mini       # cheaper alternative
# OPENROUTER_MODEL=anthropic/claude-3.5-haiku
# OPENROUTER_MODEL=openai/gpt-4o
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_NAME=LeadForge AI

# Legacy direct-Anthropic key — only used when AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-your-key-here
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@leadforge.ai
WA_API_KEY=
WA_PHONE_ID=
REDIS_URL=redis://localhost:6379
CORS_ORIGINS=http://localhost:5173

# ----------------------------------------------------------------------
# Public base URL — used to build OAuth redirect URIs and webhook URLs
# rendered to provider dashboards. In production this MUST be the public
# HTTPS URL of the frontend (e.g. https://app.leadforge.ai); the OAuth
# callback redirects the browser back to ${PUBLIC_BASE_URL}/social?...
# ----------------------------------------------------------------------
PUBLIC_BASE_URL=http://localhost:5173

# ----------------------------------------------------------------------
# Meta App credentials — required for the LeadForge Social module
# (Instagram DM automation). Without these, /social/oauth/instagram/start
# returns HTTP 503 and the Connect Instagram button fails.
#
#   META_APP_ID                 from https://developers.facebook.com → App Settings → Basic
#   META_APP_SECRET             same screen, "Show" reveals it
#   META_WEBHOOK_VERIFY_TOKEN   any random string; the SAME value must
#                               be configured on the Meta App's Webhooks
#                               panel for Instagram → Verify Token
# ----------------------------------------------------------------------
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# ----------------------------------------------------------------------
# Encryption key for at-rest credential storage in the integrations
# table (Page Access Tokens, OAuth refresh tokens, etc). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leaving this blank in production logs a loud warning and falls back
# to deriving from SECRET_KEY — DO NOT ship that way.
# ----------------------------------------------------------------------
INTEGRATIONS_ENCRYPTION_KEY=
AI_MAX_TOKENS_PER_CALL=4096
AI_MONTHLY_LIMIT_STARTER=500
AI_MONTHLY_LIMIT_GROWTH=5000
AI_MONTHLY_LIMIT_ENTERPRISE=50000
